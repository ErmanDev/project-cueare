# Copy to staging.env. This file is intentionally ignored by Git.
# Use secret-manager injection instead of an env file in production.

POSTGRES_DB=ssc
POSTGRES_USER=ssc_app
POSTGRES_PASSWORD=replace-with-a-long-random-password

DATABASE_NAME=ssc
DATABASE_USER=ssc_app
DATABASE_PASSWORD=replace-with-a-long-random-password
DATABASE_PORT=5432
DATABASE_SSL_MODE=disable

JWT_SECRET=replace-with-at-least-32-random-characters
QR_HMAC_SECRET=replace-with-a-different-32-character-secret
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080
TRUST_PROXY_HOPS=0
