<?xml version="1.0" encoding="UTF-8"?>
<!--
  Optional: rename this file to ../web.config if IIS should start Bun itself
  (HttpPlatformHandler) instead of reverse-proxying a separately running process.
  Install HttpPlatformHandler, then put bun.exe on the *system* PATH
  (IIS app pools do not see your user PATH).
-->
<configuration>
  <system.webServer>
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform
      processPath="bun.exe"
      arguments="src/nest/main.ts"
      stdoutLogEnabled="true"
      stdoutLogFile=".\logs\stdout"
      startupTimeLimit="60"
      processesPerApplication="1">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="LISTEN_HOST" value="127.0.0.1" />
        <environmentVariable name="TRUST_PROXY" value="true" />
      </environmentVariables>
    </httpPlatform>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
