# Copy to .env or set in your shell before running the server.
# Never commit real passwords.

# development | test | staging | production
APP_ENV=development

# Deployment metadata shown in startup logs and /api/v2/health when present.
# RELEASE_VERSION=1.0.0
# RELEASE_REVISION=<git-commit-sha>

# Preferred single URL:
# DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/aclc

# Or discrete vars (used when DATABASE_URL is unset):
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=aclc
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
# disable | require | verify-full. Production must set this explicitly; a
# remote production database cannot use disable.
# DATABASE_SSL_MODE=verify-full
# Optional PEM CA text. Use literal \n when a secret store requires one line.
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Development automatically applies versioned migrations for compatibility.
# Production requires false and migrations must run once as a deployment job.
# AUTO_MIGRATE=true

# PostgreSQL resilience. PG_MAX_POOL remains accepted as a legacy alias for
# PG_POOL_MAX during rollout. Set a timeout to 0 only to disable that database
# session timeout deliberately.
# PG_POOL_MAX=30
# PG_CONNECTION_TIMEOUT_MS=5000
# PG_IDLE_TIMEOUT_MS=30000
# PG_STATEMENT_TIMEOUT_MS=30000
# PG_LOCK_TIMEOUT_MS=5000
# PG_IDLE_TRANSACTION_TIMEOUT_MS=30000

# Expired attendance idempotency records are removed in bounded batches. Set
# the interval to 0 only when an external maintenance job owns cleanup.
# IDEMPOTENCY_CLEANUP_INTERVAL_MS=3600000
# IDEMPOTENCY_CLEANUP_BATCH_SIZE=1000

# Integration tests require PostgreSQL in CI. Local tests may skip only when the
# database cannot be reached; schema bootstrap failures always fail.
# TEST_DATABASE_REQUIRED=true

# Listen on localhost only. IIS (port 80/443) is the public front. Production
# must state the number of trusted proxy hops explicitly (1 for direct IIS).
# LISTEN_HOST=127.0.0.1
# PORT=8080
# TRUST_PROXY_HOPS=1
# Comma-separated exact browser origins. Wildcards are rejected in production.
# CORS_ALLOWED_ORIGINS=https://attendance.example.edu
# JWT_SECRET=
# JWT_TTL_HOURS=12
# QR_HMAC_SECRET=

# Explicit request-body ceilings in bytes (defaults preserve the legacy 8 MiB
# limits). Tune JSON lower when bulk imports no longer use JSON.
# HTTP_JSON_LIMIT_BYTES=8388608
# HTTP_TEXT_LIMIT_BYTES=8388608
# HTTP_FILE_LIMIT_BYTES=8388608
