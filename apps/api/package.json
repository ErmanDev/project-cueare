{
  "name": "ssc-qr-attendance-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SSC QR Attendance REST API (NestJS migration host + Express compatibility + PostgreSQL)",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun --watch src/nest/main.ts",
    "dev:nest": "bun --watch src/nest/main.ts",
    "dev:legacy": "bun --watch src/legacy/main.ts",
    "start": "bun src/nest/main.ts",
    "start:nest": "bun src/nest/main.ts",
    "start:legacy": "bun src/legacy/main.ts",
    "start:admin": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/build/start-admin.ps1",
    "build:web": "bun scripts/build/build-web.ts",
    "build:iis": "bun scripts/build/package-iis.ts",
    "ensure-db": "bun scripts/maintenance/ensure-database.ts",
    "env:status": "bun scripts/maintenance/manage-environments.ts status",
    "env:sync": "bun scripts/maintenance/manage-environments.ts sync-all",
    "migrate:status": "bun scripts/maintenance/migrate.ts status",
    "migrate:verify": "bun scripts/maintenance/migrate.ts verify",
    "migrate:up": "bun scripts/maintenance/migrate.ts up",
    "reset-events-and-logs": "bun scripts/maintenance/reset-events-and-logs.ts",
    "seed-admin": "bun scripts/seeds/seed-admin.ts",
    "seed-sample": "bun scripts/seeds/seed-sample.ts",
    "seed-fine-templates": "bun scripts/seeds/seed-fine-templates.ts",
    "seed-acquaintance-event": "bun scripts/seeds/seed-acquaintance-event.ts",
    "seed-event-fine-rules": "bun scripts/seeds/seed-event-fine-rules.ts",
    "test": "bun test --timeout 30000",
    "test:watch": "bun test --watch --timeout 30000"
  },
  "engines": {
    "bun": "1.4.2"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@types/ws": "^8.18.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.21.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@types/swagger-ui-express": "^4.1.8",
    "typescript": "^5.9.2"
  }
}
