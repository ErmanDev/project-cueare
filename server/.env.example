# Copy to .env or set in your shell before running the server.
# Never commit real passwords.

# Preferred single URL:
# DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/aclc

# Or discrete vars (used when DATABASE_URL is unset):
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=aclc
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Listen on localhost only. IIS (port 80/443) is the public front.
# LISTEN_HOST=127.0.0.1
# PORT=8080
# TRUST_PROXY=true
# JWT_SECRET=
# JWT_TTL_HOURS=12
# QR_HMAC_SECRET=
