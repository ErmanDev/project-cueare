# Copy to .env or set in your shell before running the server.
# Never commit real passwords.

# Preferred single URL:
# DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/aclc

# Or discrete vars (used when DATABASE_URL is unset):
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=aclc
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# JWT_SECRET=
# JWT_TTL_HOURS=12
# QR_HMAC_SECRET=
