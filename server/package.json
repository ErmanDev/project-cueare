{
  "name": "ssc-qr-attendance-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SSC QR Attendance REST API (Express + TypeScript + PostgreSQL)",
  "packageManager": "bun@1.3.2",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "start:admin": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-admin.ps1",
    "build:web": "bun scripts/build-web.ts",
    "ensure-db": "bun scripts/ensure-database.ts",
    "seed-admin": "bun scripts/seed-admin.ts",
    "seed-sample": "bun scripts/seed-sample.ts",
    "test": "bun test --timeout 30000",
    "test:watch": "bun test --watch --timeout 30000"
  },
  "engines": {
    "bun": ">=1.2"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "swagger-ui-express": "^5.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@types/swagger-ui-express": "^4.1.8",
    "typescript": "^5.9.2"
  }
}