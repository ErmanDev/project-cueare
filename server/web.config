<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS starts Bun via HttpPlatformHandler.
  processPath is a full path so the app pool does not need bun on PATH.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform
      processPath="C:\Program Files\bun\bun.exe"
      arguments="src/index.ts"
      stdoutLogEnabled="true"
      stdoutLogFile=".\logs\stdout"
      startupTimeLimit="60"
      processesPerApplication="1">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="LISTEN_HOST" value="127.0.0.1" />
        <environmentVariable name="TRUST_PROXY" value="true" />
        <environmentVariable name="HOME" value="C:\inetpub\wwwroot\ssc\server\.iis-tmp" />
        <environmentVariable name="USERPROFILE" value="C:\inetpub\wwwroot\ssc\server\.iis-tmp" />
        <environmentVariable name="LOCALAPPDATA" value="C:\inetpub\wwwroot\ssc\server\.iis-tmp" />
        <environmentVariable name="TEMP" value="C:\inetpub\wwwroot\ssc\server\.iis-tmp" />
        <environmentVariable name="TMP" value="C:\inetpub\wwwroot\ssc\server\.iis-tmp" />
        <environmentVariable name="BUN_TMPDIR" value="C:\inetpub\wwwroot\ssc\server\.iis-tmp" />
      </environmentVariables>
    </httpPlatform>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
