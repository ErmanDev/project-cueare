<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS starts Bun via HttpPlatformHandler.
  processPath is a full path so the app pool does not need bun on PATH.
-->
<configuration>
  <system.webServer>
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform
      processPath="C:\bun\bun.exe"
      arguments="src/index.ts"
      stdoutLogEnabled="true"
      stdoutLogFile=".\logs\stdout"
      startupTimeLimit="60"
      processesPerApplication="1">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="LISTEN_HOST" value="127.0.0.1" />
        <environmentVariable name="TRUST_PROXY" value="true" />
        <environmentVariable name="HOME" value=".\.iis-tmp" />
        <environmentVariable name="USERPROFILE" value=".\.iis-tmp" />
        <environmentVariable name="LOCALAPPDATA" value=".\.iis-tmp" />
        <environmentVariable name="TEMP" value=".\.iis-tmp" />
        <environmentVariable name="TMP" value=".\.iis-tmp" />
        <environmentVariable name="BUN_TMPDIR" value=".\.iis-tmp" />
      </environmentVariables>
    </httpPlatform>
    <security>
      <requestFiltering>
        <verbs applyToWebDAV="false">
          <add verb="DELETE" allowed="true" />
          <add verb="PUT" allowed="true" />
          <add verb="POST" allowed="true" />
          <add verb="GET" allowed="true" />
          <add verb="OPTIONS" allowed="true" />
        </verbs>
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
